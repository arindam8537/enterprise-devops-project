        stage('Deployment Summary') {
            steps {
                script {
                    sh """
                        echo ""
                        echo "==============================================================="
                        echo "                 DEPLOYMENT SUMMARY"
                        echo "==============================================================="
                        echo " Application Name : ${APP_NAME}"
                        echo " Docker Image     : ${IMAGE_NAME}:${env.BUILD_NUMBER}"
                        echo " Container Name   : ${CONTAINER_NAME}"
                        echo ""
                        echo " System Information : http://localhost:${APP_PORT}/system/info"
                        echo " Application URL  : http://localhost:${APP_PORT}/employees"
                        echo " Health URL       : http://localhost:${APP_PORT}${HEALTH_ENDPOINT}"
                        echo " Info URL         : http://localhost:${APP_PORT}/actuator/info"
                        echo ""
                        echo "-------------- Spring Boot Actuator ----------------"
                        echo " Health Endpoint    : http://localhost:${APP_PORT}/actuator/health"
                        echo " Info Endpoint      : http://localhost:${APP_PORT}/actuator/info"
                        echo " Build Number     : ${env.BUILD_NUMBER}"
                        echo " Jenkins Job      : ${JOB_NAME}"
                        echo " Build URL        : ${BUILD_URL}"
                        echo ""
                        echo " Status           : DEPLOYMENT SUCCESSFUL"
                        echo "==============================================================="
                    """
                }
            }
        } --commented as adding new deployment summary for k8s deployment  */

        stage('Kubernetes Deployment Summary') {

            steps {

                withCredentials([
                    file(
                        credentialsId: 'docker-desktop-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {

                    sh """
                        echo ""
                        echo "==============================================================="
                        echo "              KUBERNETES DEPLOYMENT SUMMARY"
                        echo "==============================================================="

                        echo "Application       : ${APP_NAME}"
                        echo "Namespace         : ${K8S_NAMESPACE}"
                        echo "Deployment        : ${K8S_DEPLOYMENT}"
                        echo "Container         : ${K8S_CONTAINER}"

                        echo ""
                        echo "Previous Image    : ${PREVIOUS_IMAGE}"
                        echo "Current Image     : ${IMAGE_NAME}:${BUILD_NUMBER}"

                        echo ""
                        echo "Git Commit        : ${GIT_COMMIT_SHORT}"
                        echo "Jenkins Build     : ${BUILD_NUMBER}"

                        echo ""
                        echo "Deployment Status:"
                        kubectl get deployment ${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE}

                        echo ""
                        echo "Pods:"
                        kubectl get pods \
                            -n ${K8S_NAMESPACE} \
                            -l app=${APP_NAME}

                        echo ""
                        echo "Service:"
                        kubectl get service ${K8S_SERVICE} \
                            -n ${K8S_NAMESPACE}

                        echo ""
                        echo "==============================================================="
                        echo "              DEPLOYMENT SUCCESSFUL"
                        echo "==============================================================="
                    """
                }
            }
        }

    }

    post {

        success {

            echo '=========================================='
            echo 'Kubernetes deployment completed successfully.'
            echo '=========================================='
        }

        failure {

            echo '=========================================='
            echo 'Kubernetes pipeline FAILED'
            echo '=========================================='

            script {

                if (env.DEPLOYMENT_STARTED == "true") {

                    echo "Deployment was started."
                    echo "Previous image: ${env.PREVIOUS_IMAGE}"
                    echo "Starting Kubernetes rollback..."

                    withCredentials([
                        file(
                            credentialsId: 'docker-desktop-kubeconfig',
                            variable: 'KUBECONFIG'
                        )
                    ]) {

                        sh """
                            set +e

                            echo "=========================================="
                            echo "ROLLBACK STARTED"
                            echo "=========================================="

                            echo ""
                            echo "Current deployment:"
                            kubectl get deployment ${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE}

                            echo ""
                            echo "Current Pods:"
                            kubectl get pods \
                                -n ${K8S_NAMESPACE} \
                                -l app=${APP_NAME}

                            echo ""
                            echo "Rollout history:"
                            kubectl rollout history deployment/${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE}

                            echo ""
                            echo "Executing rollback..."

                            kubectl rollout undo deployment/${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE}

                            echo ""
                            echo "Waiting for rollback to complete..."

                            kubectl rollout status \
                                deployment/${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE} \
                                --timeout=${K8S_ROLLOUT_TIMEOUT}

                            ROLLBACK_STATUS=\$?

                            echo ""
                            echo "Rollback status: \$ROLLBACK_STATUS"

                            echo ""
                            echo "Deployment after rollback:"
                            kubectl get deployment ${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE}

                            echo ""
                            echo "Pods after rollback:"
                            kubectl get pods \
                                -n ${K8S_NAMESPACE} \
                                -l app=${APP_NAME}

                            echo ""
                            echo "Current image:"
                            kubectl get deployment ${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE} \
                                -o jsonpath='{.spec.template.spec.containers[0].image}'

                            echo ""

                            echo "=========================================="
                            echo "ROLLBACK PROCESS COMPLETED"
                            echo "=========================================="
                        """
                    }

                } else {

                    echo "No Kubernetes rollback required."
                    echo "Failure occurred before kubectl set image succeeded."
                }
            }
        }
    }

}