        stage('Quality Gate') {

            steps {

                timeout(time: 5, unit: 'MINUTES') {

                    waitForQualityGate abortPipeline: true

                }

            }

        } -- commented as stuck here frequently "Injecting SonarQube environment variables using the configuration: SonarQube" */

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'application/employee-service/target/*.jar', fingerprint: true
            }
        }

