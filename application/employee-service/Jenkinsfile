            }
        }

        stage('Dependency Tree') {

            steps {

                dir('application/employee-service') {

                    sh '''

                    mvn dependency:tree \
                    > ../../reports/dependency-tree.txt

                    '''

                }
            }
        }   -- commented as testing of trivy is fine ( /*     stage('Trivy Security Scan')  to till here)  */

  /*      stage('Debug Dependency Check Tool') {
            steps {
                script {
                    echo "WORKSPACE = ${env.WORKSPACE}"
                    sh 'pwd'
                    sh 'ls -la'
                }
            }
        }  */


    /*    stage('OWASP Dependency Check') {

            steps {

                sh '''

