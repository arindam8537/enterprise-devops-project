        stage('Kubernetes Deployment Summary') {

            steps {

                withCredentials([
                    file(
                        credentialsId: 'docker-desktop-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {

                    sh """
                        echo ""
                        echo "==============================================================="
                        echo "              KUBERNETES DEPLOYMENT SUMMARY"
                        echo "==============================================================="

                        echo "Application       : ${APP_NAME}"
                        echo "Namespace         : ${K8S_NAMESPACE}"
                        echo "Deployment        : ${K8S_DEPLOYMENT}"
                        echo "Container         : ${K8S_CONTAINER}"

                        echo ""
                        echo "Image             : ${IMAGE_NAME}:${BUILD_NUMBER}"
                        echo "Git Commit        : ${GIT_COMMIT_SHORT}"
                        echo "Build Number      : ${BUILD_NUMBER}"

                        echo ""
                        echo "-------------- Kubernetes Status ----------------"

                        kubectl get deployment ${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE}

                        echo ""
                        echo "Pods:"

                        kubectl get pods \
                            -n ${K8S_NAMESPACE} \
                            -l app=${APP_NAME} \
                            -o wide

                        echo ""
                        echo "Service:"

                        kubectl get service ${K8S_SERVICE} \
                            -n ${K8S_NAMESPACE}

                        echo ""
                        echo "-------------- Application Access ----------------"

                        echo "Application URL : http://localhost:${APP_PORT}/employees"
                        echo "Health URL      : http://localhost:${APP_PORT}${HEALTH_ENDPOINT}"
                        echo "Info URL        : http://localhost:${APP_PORT}/actuator/info"

                        echo ""
                        echo "NOTE:"
                        echo "The above localhost URLs require kubectl port-forward"
                        echo "from the local machine."

                        echo ""
                        echo "-------------- Jenkins Information ----------------"

                        echo "Jenkins Job     : ${JOB_NAME}"
                        echo "Build URL       : ${BUILD_URL}"

                        echo ""
                        echo "Status          : DEPLOYMENT SUCCESSFUL"

                        echo "==============================================================="
                    """
                }
            }
        }

    }

    post {

        success {
            echo "=========================================="
            echo "Kubernetes deployment completed successfully."
            echo "=========================================="
        }

        failure {

            script {

                echo "=========================================="
                echo "KUBERNETES DEPLOYMENT FAILURE HANDLER"
                echo "=========================================="

                withCredentials([
                    file(
                        credentialsId: 'docker-desktop-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {

                    sh """
                        set +e

                        REPORT_DIR="reports/k8s-deployment-failure"

                        mkdir -p "\$REPORT_DIR"

                        TARGET_IMAGE="${IMAGE_NAME}:${BUILD_NUMBER}"

                        CURRENT_IMAGE=\$(kubectl get deployment ${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE} \
                            -o jsonpath='{.spec.template.spec.containers[0].image}' 2>/dev/null)

                        echo ""
                        echo "Target Image  : \$TARGET_IMAGE"
                        echo "Current Image : \$CURRENT_IMAGE"

                        echo ""
                        echo "=========================================="
                        echo "CAPTURING KUBERNETES FAILURE EVIDENCE"
                        echo "=========================================="

                        # -------------------------------------------------
                        # 1. Deployment state
                        # -------------------------------------------------

                        echo "Capturing Deployment state..."

                        kubectl get deployment ${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE} \
                            -o wide \
                            > "\$REPORT_DIR/deployment-status.txt" 2>&1

                        kubectl get deployment ${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE} \
                            -o yaml \
                            > "\$REPORT_DIR/deployment.yaml" 2>&1

                        # -------------------------------------------------
                        # 2. Deployment conditions
                        # -------------------------------------------------

                        echo "Capturing Deployment conditions..."

                        kubectl get deployment ${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE} \
                            -o jsonpath='{range .status.conditions[*]}{.type}={.status} reason={.reason} message={.message}{"\\n"}{end}' \
                            > "\$REPORT_DIR/deployment-conditions.txt" 2>&1

                        # -------------------------------------------------
                        # 3. Pods
                        # -------------------------------------------------

                        echo "Capturing Pod state..."

                        kubectl get pods \
                            -n ${K8S_NAMESPACE} \
                            -l app=${APP_NAME} \
                            -o wide \
                            > "\$REPORT_DIR/pods.txt" 2>&1

                        # -------------------------------------------------
                        # 4. ReplicaSets
                        # -------------------------------------------------

                        echo "Capturing ReplicaSet state..."

                        kubectl get rs \
                            -n ${K8S_NAMESPACE} \
                            -l app=${APP_NAME} \
                            -o wide \
                            > "\$REPORT_DIR/replicasets.txt" 2>&1

                        # -------------------------------------------------
                        # 5. Kubernetes Events
                        # -------------------------------------------------

                        echo "Capturing Kubernetes events..."

                        kubectl get events \
                            -n ${K8S_NAMESPACE} \
                            --sort-by=.lastTimestamp \
                            > "\$REPORT_DIR/events.txt" 2>&1

                        # -------------------------------------------------
                        # 6. Pod describe information
                        # -------------------------------------------------

                        echo "Capturing Pod diagnostic information..."

                        : > "\$REPORT_DIR/pod-describe.txt"

                        for POD in \$(kubectl get pods \
                            -n ${K8S_NAMESPACE} \
                            -l app=${APP_NAME} \
                            -o jsonpath='{range .items[*]}{.metadata.name}{"\\n"}{end}' 2>/dev/null)
                        do

                            echo "==================================================" \
                                >> "\$REPORT_DIR/pod-describe.txt"

                            echo "POD: \$POD" \
                                >> "\$REPORT_DIR/pod-describe.txt"

                            echo "==================================================" \
                                >> "\$REPORT_DIR/pod-describe.txt"

                            kubectl describe pod "\$POD" \
                                -n ${K8S_NAMESPACE} \
                                >> "\$REPORT_DIR/pod-describe.txt" 2>&1

                            echo "" >> "\$REPORT_DIR/pod-describe.txt"

                        done

                        # -------------------------------------------------
                        # 7. Container state
                        # -------------------------------------------------

                        echo "Capturing container states..."

                        : > "\$REPORT_DIR/container-state.txt"

                        for POD in \$(kubectl get pods \
                            -n ${K8S_NAMESPACE} \
                            -l app=${APP_NAME} \
                            -o jsonpath='{range .items[*]}{.metadata.name}{"\\n"}{end}' 2>/dev/null)
                        do

                            echo "==================================================" \
                                >> "\$REPORT_DIR/container-state.txt"

                            echo "POD: \$POD" \
                                >> "\$REPORT_DIR/container-state.txt"

                            echo "==================================================" \
                                >> "\$REPORT_DIR/container-state.txt"

                            kubectl get pod "\$POD" \
                                -n ${K8S_NAMESPACE} \
                                -o jsonpath='{range .status.containerStatuses[*]}container={.name} ready={.ready} restartCount={.restartCount} state={.state}{"\\n"}{end}' \
                                >> "\$REPORT_DIR/container-state.txt" 2>&1

                            echo "" >> "\$REPORT_DIR/container-state.txt"

                        done

                        # -------------------------------------------------
                        # 8. Application logs
                        # -------------------------------------------------

                        echo "Capturing application logs..."

                        : > "\$REPORT_DIR/pod-logs.txt"

                        for POD in \$(kubectl get pods \
                            -n ${K8S_NAMESPACE} \
                            -l app=${APP_NAME} \
                            -o jsonpath='{range .items[*]}{.metadata.name}{"\\n"}{end}' 2>/dev/null)
                        do

                            echo "==================================================" \
                                >> "\$REPORT_DIR/pod-logs.txt"

                            echo "POD: \$POD" \
                                >> "\$REPORT_DIR/pod-logs.txt"

                            echo "==================================================" \
                                >> "\$REPORT_DIR/pod-logs.txt"

                            kubectl logs "\$POD" \
                                -n ${K8S_NAMESPACE} \
                                --all-containers=true \
                                --tail=200 \
                                >> "\$REPORT_DIR/pod-logs.txt" 2>&1

                            echo "" >> "\$REPORT_DIR/pod-logs.txt"

                            echo "--------------- PREVIOUS CONTAINER LOGS ---------------" \
                                >> "\$REPORT_DIR/pod-logs.txt"

                            kubectl logs "\$POD" \
                                -n ${K8S_NAMESPACE} \
                                --all-containers=true \
                                --previous \
                                --tail=200 \
                                >> "\$REPORT_DIR/pod-logs.txt" 2>&1

                            echo "" >> "\$REPORT_DIR/pod-logs.txt"

                        done

                        # -------------------------------------------------
                        # 9. Generate human-readable report
                        # -------------------------------------------------

                        echo "Generating failure report..."

                        {
                            echo "============================================================"
                            echo "KUBERNETES DEPLOYMENT FAILURE REPORT"
                            echo "============================================================"
                            echo ""

                            echo "Application       : ${APP_NAME}"
                            echo "Namespace         : ${K8S_NAMESPACE}"
                            echo "Deployment        : ${K8S_DEPLOYMENT}"
                            echo "Container         : ${K8S_CONTAINER}"
                            echo "Jenkins Job       : ${JOB_NAME}"
                            echo "Jenkins Build     : ${BUILD_NUMBER}"
                            echo "Build URL         : ${BUILD_URL}"
                            echo "Git Commit        : ${GIT_COMMIT_SHORT}"
                            echo "Target Image      : \$TARGET_IMAGE"
                            echo "Current Image     : \$CURRENT_IMAGE"
                            echo ""

                            echo "============================================================"
                            echo "DEPLOYMENT STATUS"
                            echo "============================================================"

                            cat "\$REPORT_DIR/deployment-status.txt"

                            echo ""
                            echo "============================================================"
                            echo "DEPLOYMENT CONDITIONS"
                            echo "============================================================"

                            cat "\$REPORT_DIR/deployment-conditions.txt"

                            echo ""
                            echo "============================================================"
                            echo "PODS"
                            echo "============================================================"

                            cat "\$REPORT_DIR/pods.txt"

                            echo ""
                            echo "============================================================"
                            echo "CONTAINER STATE"
                            echo "============================================================"

                            cat "\$REPORT_DIR/container-state.txt"

                            echo ""
                            echo "============================================================"
                            echo "REPLICASETS"
                            echo "============================================================"

                            cat "\$REPORT_DIR/replicasets.txt"

                            echo ""
                            echo "============================================================"
                            echo "RECENT KUBERNETES EVENTS"
                            echo "============================================================"

                            tail -n 100 "\$REPORT_DIR/events.txt"

                            echo ""
                            echo "============================================================"
                            echo "DIAGNOSTIC EVIDENCE"
                            echo "============================================================"

                            echo "Detailed Pod information:"
                            echo "See pod-describe.txt"

                            echo ""
                            echo "Application logs:"
                            echo "See pod-logs.txt"

                            echo ""
                            echo "============================================================"
                            echo "INITIAL DIAGNOSIS"
                            echo "============================================================"

                            echo "Failure classification: UNCLASSIFIED"
                            echo ""
                            echo "This report contains the Kubernetes evidence captured"
                            echo "immediately before automatic rollback."
                            echo ""
                            echo "Failure classification will be added in the"
                            echo "Failure Classifier phase."

                            echo ""
                            echo "============================================================"

                        } > "\$REPORT_DIR/k8s-deployment-failure-report.txt"

                        # -------------------------------------------------
                        # 10. Generate machine-readable JSON
                        # -------------------------------------------------

                        echo "Generating JSON report..."

                        if command -v jq >/dev/null 2>&1; then

                            jq -n \
                                --arg application "${APP_NAME}" \
                                --arg namespace "${K8S_NAMESPACE}" \
                                --arg deployment "${K8S_DEPLOYMENT}" \
                                --arg container "${K8S_CONTAINER}" \
                                --arg build "${BUILD_NUMBER}" \
                                --arg job "${JOB_NAME}" \
                                --arg buildUrl "${BUILD_URL}" \
                                --arg commit "${GIT_COMMIT_SHORT}" \
                                --arg targetImage "\$TARGET_IMAGE" \
                                --arg currentImage "\$CURRENT_IMAGE" \
                                --arg failureCategory "UNCLASSIFIED" \
                                '{
                                    application: \$application,
                                    namespace: \$namespace,
                                    deployment: \$deployment,
                                    container: \$container,
                                    jenkinsJob: \$job,
                                    jenkinsBuild: \$build,
                                    buildUrl: \$buildUrl,
                                    gitCommit: \$commit,
                                    targetImage: \$targetImage,
                                    currentImage: \$currentImage,
                                    failureCategory: \$failureCategory,
                                    rollback: {
                                        status: "PENDING"
                                    }
                                }' \
                                > "\$REPORT_DIR/k8s-deployment-failure-report.json"

                        else

                            echo "WARNING: jq not available. JSON report not generated."

                        fi

                        echo ""
                        echo "=========================================="
                        echo "FAILURE EVIDENCE CAPTURE COMPLETED"
                        echo "=========================================="

                        echo ""
                        echo "Diagnostic report directory:"
                        echo "\$REPORT_DIR"

                        echo ""
                        echo "Files:"
                        ls -lh "\$REPORT_DIR"

                        echo ""
                        echo "=========================================="
                        echo "FAILURE CLASSIFICATION"
                        echo "=========================================="

                        # Phase 2 purpose:
                        # Convert captured Kubernetes evidence into an initial
                        # failure category, confidence level, and reason.
                        #
                        # This is NOT a guaranteed RCA. It is an automated
                        # first classification to help the support/SRE team
                        # start investigation immediately.

                        FAILURE_CATEGORY="UNKNOWN_ROLLOUT_FAILURE"
                        CLASSIFICATION_CONFIDENCE="LOW"
                        CLASSIFICATION_REASON="No specific failure signature detected."

                        EVENTS_FILE="\${REPORT_DIR}/events.txt"
                        PODS_FILE="\${REPORT_DIR}/pods.txt"
                        CONTAINER_STATE_FILE="\${REPORT_DIR}/container-state.txt"
                        POD_LOGS_FILE="\${REPORT_DIR}/pod-logs.txt"
                        DEPLOYMENT_STATUS_FILE="\${REPORT_DIR}/deployment-status.txt"
                        DEPLOYMENT_CONDITIONS_FILE="\${REPORT_DIR}/deployment-conditions.txt"

                        # IMPORTANT:
                        # Check specific signatures before generic timeout/error
                        # patterns. This prevents a sandbox/image/probe failure
                        # from being incorrectly classified as only a timeout.

                        if grep -qi "FailedCreatePodSandBox" "\${EVENTS_FILE}"; then

                            FAILURE_CATEGORY="SANDBOX_INFRASTRUCTURE_FAILURE"
                            CLASSIFICATION_CONFIDENCE="HIGH"
                            CLASSIFICATION_REASON="Kubernetes reported FailedCreatePodSandBox while creating the Pod sandbox."

                        elif grep -qiE "ImagePullBackOff|ErrImagePull|pull access denied|manifest unknown|image.*not found" "\${EVENTS_FILE}"; then

                            FAILURE_CATEGORY="IMAGE_PULL_FAILURE"
                            CLASSIFICATION_CONFIDENCE="HIGH"
                            CLASSIFICATION_REASON="Kubernetes reported an image pull or image availability failure."

                        elif grep -qiE "CreateContainerConfigError|secret.*not found|configmap.*not found|config.*error" "\${EVENTS_FILE}" "\${CONTAINER_STATE_FILE}"; then

                            FAILURE_CATEGORY="CONFIGURATION_FAILURE"
                            CLASSIFICATION_CONFIDENCE="HIGH"
                            CLASSIFICATION_REASON="Kubernetes reported a container configuration, Secret, or ConfigMap failure."

                        elif grep -qiE "Readiness probe failed|readiness probe" "\${EVENTS_FILE}"; then

                            FAILURE_CATEGORY="READINESS_PROBE_FAILURE"
                            CLASSIFICATION_CONFIDENCE="HIGH"
                            CLASSIFICATION_REASON="Kubernetes reported a readiness probe failure."

                        elif grep -qiE "Liveness probe failed|liveness probe" "\${EVENTS_FILE}"; then

                            FAILURE_CATEGORY="LIVENESS_PROBE_FAILURE"
                            CLASSIFICATION_CONFIDENCE="HIGH"
                            CLASSIFICATION_REASON="Kubernetes reported a liveness probe failure."

                        elif grep -qiE "CrashLoopBackOff|Back-off restarting failed container" "\${EVENTS_FILE}" "\${CONTAINER_STATE_FILE}"; then

                            FAILURE_CATEGORY="CRASH_LOOP"
                            CLASSIFICATION_CONFIDENCE="HIGH"
                            CLASSIFICATION_REASON="Container restart/back-off behavior was detected."

                        elif grep -qiE "FailedScheduling|Insufficient cpu|Insufficient memory|node selector|taint|toleration" "\${EVENTS_FILE}"; then

                            FAILURE_CATEGORY="SCHEDULING_FAILURE"
                            CLASSIFICATION_CONFIDENCE="HIGH"
                            CLASSIFICATION_REASON="Kubernetes reported a scheduling or node-placement failure."

                        elif grep -qiE "OOMKilled|OutOfMemory" "\${EVENTS_FILE}" "\${CONTAINER_STATE_FILE}"; then

                            FAILURE_CATEGORY="RESOURCE_FAILURE"
                            CLASSIFICATION_CONFIDENCE="HIGH"
                            CLASSIFICATION_REASON="Container resource exhaustion such as OOMKilled/OutOfMemory was detected."

                        elif grep -qiE "ProgressDeadlineExceeded|timeout|timed out" "\${EVENTS_FILE}" "\${DEPLOYMENT_STATUS_FILE}" "\${DEPLOYMENT_CONDITIONS_FILE}"; then

                            FAILURE_CATEGORY="ROLLOUT_TIMEOUT"
                            CLASSIFICATION_CONFIDENCE="MEDIUM"
                            CLASSIFICATION_REASON="The Deployment did not make sufficient rollout progress within the expected time."

                        elif grep -qiE "Exception|ERROR|Caused by:" "\${POD_LOGS_FILE}"; then

                            FAILURE_CATEGORY="APPLICATION_STARTUP_FAILURE"
                            CLASSIFICATION_CONFIDENCE="MEDIUM"
                            CLASSIFICATION_REASON="Application/container logs contain startup error signatures."

                        fi

                        echo ""
                        echo "Failure Category       : \${FAILURE_CATEGORY}"
                        echo "Classification         : \${CLASSIFICATION_CONFIDENCE}"
                        echo "Reason                 : \${CLASSIFICATION_REASON}"

                        printf '%s\n' \
                            "============================================================" \
                            "KUBERNETES FAILURE CLASSIFICATION" \
                            "============================================================" \
                            "" \
                            "Application       : ${APP_NAME}" \
                            "Namespace         : ${K8S_NAMESPACE}" \
                            "Deployment        : ${K8S_DEPLOYMENT}" \
                            "Container         : ${K8S_CONTAINER}" \
                            "Jenkins Build     : ${BUILD_NUMBER}" \
                            "" \
                            "Failure Category  : \${FAILURE_CATEGORY}" \
                            "Confidence        : \${CLASSIFICATION_CONFIDENCE}" \
                            "" \
                            "Reason:" \
                            "\${CLASSIFICATION_REASON}" \
                            "" \
                            "This is an initial automated diagnosis based on Kubernetes" \
                            "evidence captured before rollback. It is not a guaranteed RCA." \
                            "" \
                            "============================================================" \
                            > "\${REPORT_DIR}/classification.txt"

                        # Add the Phase 2 classification to the main
                        # human-readable report that was generated above.
                        printf '%s\n' \
                            "" \
                            "============================================================" \
                            "FAILURE CLASSIFICATION" \
                            "============================================================" \
                            "" \
                            "Failure Category  : \${FAILURE_CATEGORY}" \
                            "Confidence        : \${CLASSIFICATION_CONFIDENCE}" \
                            "Reason            : \${CLASSIFICATION_REASON}" \
                            "" \
                            "Classification is an initial automated diagnosis based on" \
                            "Kubernetes evidence captured before rollback." \
                            "" \
                            "============================================================" \
                            >> "\${REPORT_DIR}/k8s-deployment-failure-report.txt"

                        # Update the machine-readable JSON with the actual
                        # classifier result generated above.
                        if command -v jq >/dev/null 2>&1 && [ -f "\${REPORT_DIR}/k8s-deployment-failure-report.json" ]; then

                            jq --arg category "\${FAILURE_CATEGORY}" \
                               --arg confidence "\${CLASSIFICATION_CONFIDENCE}" \
                               --arg reason "\${CLASSIFICATION_REASON}" \
                               '.failureCategory = $category |
                                .classificationConfidence = $confidence |
                                .classificationReason = $reason' \
                               "\${REPORT_DIR}/k8s-deployment-failure-report.json" \
                               > "\${REPORT_DIR}/report.tmp"

                            if [ "$?" -eq 0 ]; then
                                mv "\${REPORT_DIR}/report.tmp" \
                                   "\${REPORT_DIR}/k8s-deployment-failure-report.json"
                            else
                                echo "WARNING: Unable to update JSON report with classification."
                                rm -f "\${REPORT_DIR}/report.tmp"
                            fi

                        else
                            echo "WARNING: JSON report not available for classification update."
                        fi

                        echo ""
                        echo "=========================================="
                        echo "FAILURE CLASSIFICATION COMPLETED"
                        echo "=========================================="

                        # -------------------------------------------------
                        # IMPORTANT:
                        # Failure evidence has now been captured.
                        # Only now do we perform rollback.
                        # -------------------------------------------------

                        if [ "\$CURRENT_IMAGE" = "\$TARGET_IMAGE" ]; then

                            echo ""
                            echo "=========================================="
                            echo "ROLLBACK REQUIRED"
                            echo "=========================================="

                            echo "Deployment is still pointing to the failed build."

                            echo ""
                            echo "Executing Kubernetes rollback..."

                            kubectl rollout history \
                                deployment/${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE}

                            echo ""
                            echo "=========================================="
                            echo "ROLLBACK / RECOVERY"
                            echo "=========================================="

                            PREVIOUS_IMAGE="\${CURRENT_IMAGE}"

                            printf '%s\n' \
                                "============================================================" \
                                "KUBERNETES ROLLBACK / RECOVERY REPORT" \
                                "============================================================" \
                                "" \
                                "Application       : ${APP_NAME}" \
                                "Namespace         : ${K8S_NAMESPACE}" \
                                "Deployment        : ${K8S_DEPLOYMENT}" \
                                "Jenkins Build     : ${BUILD_NUMBER}" \
                                "" \
                                "Failed Image:" \
                                "\${TARGET_IMAGE}" \
                                "" \
                                "Image Before Rollback:" \
                                "\${PREVIOUS_IMAGE}" \
                                "" \
                                "Rollback Status:" \
                                "STARTED" \
                                "" \
                                "============================================================" \
                                > "\${REPORT_DIR}/rollback-recovery.txt"

                            kubectl rollout undo \
                                deployment/${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE}

                            UNDO_STATUS=\$?

                            if [ "\$UNDO_STATUS" -ne 0 ]; then

                                echo "Rollback command failed."

                                exit 1

                            fi

                            echo "Rollback command completed."

                            echo ""
                            echo "Waiting for rollback to complete..."

                            kubectl rollout status \
                                deployment/${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE} \
                                --timeout=${K8S_ROLLOUT_TIMEOUT}

                            ROLLBACK_STATUS=\$?

                            echo ""
                            echo "Rollback status: \$ROLLBACK_STATUS"

                            ROLLBACK_IMAGE=\$(kubectl get deployment ${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE} \
                                -o jsonpath='{.spec.template.spec.containers[0].image}')

                            echo ""
                            echo "=========================================="
                            echo "POST-ROLLBACK VERIFICATION"
                            echo "=========================================="

                            echo "Recovered image: \$ROLLBACK_IMAGE"

                            kubectl get deployment ${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE}

                            echo ""
                            echo "Pods after rollback:"

                            kubectl get pods \
                                -n ${K8S_NAMESPACE} \
                                -l app=${APP_NAME} \
                                -o wide

                            # Update JSON report with rollback result.
                            if command -v jq >/dev/null 2>&1; then

                                if [ "\$ROLLBACK_STATUS" -eq 0 ]; then

                                    jq \
                                        --arg status "SUCCESSFUL" \
                                        --arg image "\$ROLLBACK_IMAGE" \
                                        '.rollback.status = \$status |
                                        .rollback.recoveredImage = \$image' \
                                        "\$REPORT_DIR/k8s-deployment-failure-report.json" \
                                        > "\$REPORT_DIR/report.tmp"

                                    mv "\$REPORT_DIR/report.tmp" \
                                    "\$REPORT_DIR/k8s-deployment-failure-report.json"

                                else

                                    jq \
                                        --arg status "FAILED" \
                                        '.rollback.status = \$status' \
                                        "\$REPORT_DIR/k8s-deployment-failure-report.json" \
                                        > "\$REPORT_DIR/report.tmp"

                                    mv "\$REPORT_DIR/report.tmp" \
                                    "\$REPORT_DIR/k8s-deployment-failure-report.json"

                                fi

                            fi

                            if [ "\$ROLLBACK_STATUS" -ne 0 ]; then

                                echo ""
                                echo "=========================================="
                                echo "ROLLBACK FAILED"
                                echo "=========================================="

                                exit 1

                            fi

                            if [ "\$ROLLBACK_IMAGE" = "\$TARGET_IMAGE" ]; then

                                echo "ERROR: Rollback did not change the Deployment image."

                                exit 1

                            fi

                            echo ""
                            echo "=========================================="
                            echo "AUTOMATIC ROLLBACK SUCCESSFUL"
                            echo "=========================================="

                            echo "Recovered image: \$ROLLBACK_IMAGE"

                        else

                            echo ""
                            echo "=========================================="
                            echo "NO ROLLBACK REQUIRED"
                            echo "=========================================="

                            echo "Failure occurred before this build changed the Deployment image."

                        fi
                    """
                    // Archive the evidence even though this Jenkins build is FAILED.
                    archiveArtifacts artifacts: 'reports/k8s-deployment-failure/**',
                                    allowEmptyArchive: true,
                                    fingerprint: true

                    echo ""
                    echo "=========================================="
                    echo "KUBERNETES FAILURE REPORT ARCHIVED"
                    echo "=========================================="
                    echo "Jenkins build remains FAILED by design."
                    echo "Rollback recovery does not make the deployment build successful."
                    echo "=========================================="
                }
            }
        }

        cleanup {
            script {
                if (env.DOCKER_CLEANUP_ENABLED == 'true') {

                    echo "=========================================="
                    echo "DOCKER CLEANUP"
                    echo "=========================================="

                    sh """
                        set +e

                        echo "Docker disk usage BEFORE cleanup:"
                        docker system df

                        echo ""
                        echo "Removing unused Docker images older than 24 hours..."
                        docker image prune -af --filter "until=24h"

                        echo ""
                        echo "Docker disk usage AFTER cleanup:"
                        docker system df

                        echo ""
                        echo "Docker cleanup completed."
                    """

                } else {
                    echo "Docker cleanup is disabled. Set DOCKER_CLEANUP_ENABLED=true to enable it."
                }
            }
        }
    }

}
