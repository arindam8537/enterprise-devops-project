// added new Deploy Container stage to skip tag latest instead will use build number tag for deployment to 
// avoid issues with latest tag caching in docker and also to maintain versioning of docker images for better 
// traceability and rollback if needed
  /*      stage('Deploy Container') {

            steps {

                dir("${COMPOSE_DIR}") {

                    withEnv([
                        "IMAGE_NAME=${IMAGE_NAME}:latest"
                    ]) {

                        sh '''
                            docker compose down || true
                            docker compose pull
                            docker compose up -d
                        '''
                    }
                }
            }
        }    */

        stage('Deploy Container') {

            steps {

                script {

                    // Capture currently running version
                    env.PREVIOUS_IMAGE = sh(
                        script: """
                            docker inspect -f '{{.Config.Image}}' ${CONTAINER_NAME} 2>/dev/null || true
                        """,
                        returnStdout: true
                    ).trim()

                    echo "Previous running image: ${env.PREVIOUS_IMAGE}"

                    // Mark that deployment has started
                    env.DEPLOYMENT_STARTED = "true"

                    // Deploy current immutable build
                    dir("${COMPOSE_DIR}") {

                        withEnv([
                            "IMAGE_TAG=${env.BUILD_NUMBER}"
                        ]) {

                            sh '''
                                echo "=========================================="
                                echo "Deploying Employee Service"
                                echo "=========================================="

                                echo "Previous Image : ${PREVIOUS_IMAGE}"
                                echo "New Image      : ${IMAGE_NAME}:${IMAGE_TAG}"

                                docker compose down || true

                                docker compose pull

                                docker compose up -d

                                echo "Deployment command completed."
                            '''
                        }
                    }
                }
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    echo "========================================"
                    echo "Starting Health Check..."
                    echo "========================================"

                    MAX_RETRIES=12
                    RETRY_INTERVAL=5
                    COUNT=1

                    while [ $COUNT -le $MAX_RETRIES ]
                    do
                        echo ""
                        echo "Attempt $COUNT of $MAX_RETRIES"

                        if docker exec ${CONTAINER_NAME} \
                            wget -q --spider http://localhost:${APP_PORT}${HEALTH_ENDPOINT}
                        then
                            echo ""
                            echo "Application is Healthy"
                            docker exec ${CONTAINER_NAME} \
                                wget -qO- http://localhost:${APP_PORT}${HEALTH_ENDPOINT}
                            exit 0
                        fi

                        echo "Application not ready..."
                        sleep $RETRY_INTERVAL

                        COUNT=$((COUNT+1))
                    done

                    echo ""
                    echo "Health Check Failed"

                    echo ""
                    echo "========= Container Logs ========="
                    docker logs ${CONTAINER_NAME}

                    exit 1
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                sh """
                    EMAIL="arindam${env.BUILD_NUMBER}@gmail.com"

                    echo "Creating Employee..."

                    docker run --rm \
                        --network ${NETWORK_NAME} \
                        curlimages/curl:latest \
                        -s \
                        -X POST \
                        http://${CONTAINER_NAME}:${APP_PORT}/employees \
                        -H "Content-Type: application/json" \
                        -d '{
                            "firstName":"Arindam",
                            "lastName":"Tiwari",
                            "email":"'"\$EMAIL"'",
                            "department":"DevOps",
                            "salary":90000
                        }'

                    echo ""
                    echo "Verifying Employee..."

                    docker run --rm \
                        --network ${NETWORK_NAME} \
                        curlimages/curl:latest \
                        -s \
                        http://${CONTAINER_NAME}:${APP_PORT}/employees \
                        > employees.json

                    cat employees.json

                    grep "\$EMAIL" employees.json

                    echo ""
                    echo "Smoke Test Passed"
                """
            }
        }

        stage('Deployment Summary') {
            steps {
                script {
                    sh """
                        echo ""
                        echo "==============================================================="
                        echo "                 DEPLOYMENT SUMMARY"
                        echo "==============================================================="
                        echo " Application Name : ${APP_NAME}"
                        echo " Docker Image     : ${IMAGE_NAME}:${env.BUILD_NUMBER}"
                        echo " Container Name   : ${CONTAINER_NAME}"
                        echo ""
                        echo " System Information : http://localhost:${APP_PORT}/system/info"
                        echo " Application URL  : http://localhost:${APP_PORT}/employees"
                        echo " Health URL       : http://localhost:${APP_PORT}${HEALTH_ENDPOINT}"
                        echo " Info URL         : http://localhost:${APP_PORT}/actuator/info"
                        echo ""
                        echo "-------------- Spring Boot Actuator ----------------"
                        echo " Health Endpoint    : http://localhost:${APP_PORT}/actuator/health"
                        echo " Info Endpoint      : http://localhost:${APP_PORT}/actuator/info"
                        echo " Build Number     : ${env.BUILD_NUMBER}"
                        echo " Jenkins Job      : ${JOB_NAME}"
                        echo " Build URL        : ${BUILD_URL}"
                        echo ""
                        echo " Status           : DEPLOYMENT SUCCESSFUL"
                        echo "==============================================================="
                    """
                }
            }
        }

