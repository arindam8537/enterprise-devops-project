pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
    }

    environment {
        // Application
        APP_NAME        = "employee-service"
        APP_PORT        = "8081"

        // Docker
        DOCKER_USERNAME = "arindamtiwari"
        IMAGE_NAME      = "${DOCKER_USERNAME}/${APP_NAME}"
        CONTAINER_NAME  = "employee-service"

        // Docker Compose
        COMPOSE_DIR     = "deployment"
        NETWORK_NAME    = "deployment_employee-network"

        // SonarQube
        SONARQUBE_SERVER = "SonarQube"
        SONAR_PROJECT_KEY = "employee-service"
        SONAR_PLUGIN_VERSION = "5.7.0.6970"

        // Health Check
        HEALTH_ENDPOINT = "/actuator/health"
    }



 /*   environment {
        APP_NAME   = "employee-service"
        IMAGE_NAME = "arindamtiwari/employee-service"
       // IMAGE_TAG  = "${BUILD_NUMBER}"
        APP_PORT   = "8081"
        SONARQUBE_SERVER = "SonarQube"
    } */

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('application/employee-service') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONARQUBE_SERVER}") {
                    dir('application/employee-service') {
                        sh """
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:${SONAR_PLUGIN_VERSION}:sonar \
                            -Dsonar.projectKey=${SONAR_PROJECT_KEY}
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {

            steps {

                timeout(time: 5, unit: 'MINUTES') {

                    waitForQualityGate abortPipeline: true

                }

            }

        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'application/employee-service/target/*.jar', fingerprint: true
            }
        }

 /*      stage('Debug') {
            steps {
                echo "BUILD_NUMBER = ${env.BUILD_NUMBER}"
                echo "IMAGE_NAME   = ${IMAGE_NAME}"
            }
        } */

        stage('Build Docker Image') {
            steps {
                dir('application/employee-service') {
                    sh """
                        docker build -t ${IMAGE_NAME}:${env.BUILD_NUMBER} .
                        docker tag ${IMAGE_NAME}:${env.BUILD_NUMBER} ${IMAGE_NAME}:latest
                    """
                }
            }
        }
        // DevSecOps (Trivy Image Scan) // commented out for now, as we want reports in text, json and html formats for better analysis and reporting
   /*     stage('Trivy Image Scan') {

            steps {

                sh '''
                    echo "==============================================="
                    echo "Scanning Docker Image using Trivy"
                    echo "==============================================="

                    docker run --rm \
                    -v /var/run/docker.sock:/var/run/docker.sock \
                    aquasec/trivy:0.73.0 image \
                    --timeout 15m \
                    --severity HIGH,CRITICAL \
                    --exit-code 1 \
                    --no-progress \
                    ${IMAGE_NAME}:${BUILD_NUMBER}

                    echo ""
                    echo "Trivy Scan Passed Successfully"
                '''
            }
        }  */

        stage('Dependency Tree') {

            steps {

                dir('application/employee-service') {

                    sh '''

                    mvn dependency:tree \
                    > ../../reports/dependency-tree.txt

                    '''

                }
            }
        }

        stage('Trivy Security Scan') {

            steps {

                sh '''

                mkdir -p reports

                echo "Scanning Docker Image..."

                trivy image \
                    --severity HIGH,CRITICAL \
                    --format table \
                    -o reports/trivy-report.txt \
                    ${IMAGE_NAME}:${BUILD_NUMBER}

                trivy image \
                    --severity HIGH,CRITICAL \
                    --format json \
                    -o reports/trivy-report.json \
                    ${IMAGE_NAME}:${BUILD_NUMBER}

                trivy image \
                    --severity HIGH,CRITICAL \
                    --format template \
                    --template "@reports/templates/html.tpl" \
                    -o reports/trivy-report.html \
                    ${IMAGE_NAME}:${BUILD_NUMBER}

                '''
            }
        }

        stage('Archive Security Reports') {

            steps {

                archiveArtifacts artifacts: 'reports/**', fingerprint: true

            }
        }

        stage('Docker Push') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${env.BUILD_NUMBER}
                        docker push ${IMAGE_NAME}:latest
                        docker logout
                    """
                }
            }
        }

  /*      stage('Deploy Container') {
            steps {
                sh """
                    docker stop employee-service || true
                    docker rm -f employee-service || true

                    docker run -d \
                    --name employee-service \
                    --restart unless-stopped \
                    --network employee-service_default \
                    -p 8081:8081 \
                    -e SPRING_DATASOURCE_URL=jdbc:mysql://employee-mysql:3306/employee_db \
                    -e SPRING_DATASOURCE_USERNAME=root \
                    -e SPRING_DATASOURCE_PASSWORD=root \
                    ${IMAGE_NAME}:${env.BUILD_NUMBER}
                """
            }
        }  */

        stage('Deploy Container') {

            steps {

                dir("${COMPOSE_DIR}") {

                    withEnv([
                        "IMAGE_NAME=${IMAGE_NAME}:latest"
                    ]) {

                        sh '''
                            docker compose down || true
                            docker compose pull
                            docker compose up -d
                        '''
                    }
                }
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    echo "========================================"
                    echo "Starting Health Check..."
                    echo "========================================"

                    MAX_RETRIES=12
                    RETRY_INTERVAL=5
                    COUNT=1

                    while [ $COUNT -le $MAX_RETRIES ]
                    do
                        echo ""
                        echo "Attempt $COUNT of $MAX_RETRIES"

                        if docker exec ${CONTAINER_NAME} \
                            wget -q --spider http://localhost:${APP_PORT}${HEALTH_ENDPOINT}
                        then
                            echo ""
                            echo "Application is Healthy"
                            docker exec ${CONTAINER_NAME} \
                                wget -qO- http://localhost:${APP_PORT}${HEALTH_ENDPOINT}
                            exit 0
                        fi

                        echo "Application not ready..."
                        sleep $RETRY_INTERVAL

                        COUNT=$((COUNT+1))
                    done

                    echo ""
                    echo "Health Check Failed"

                    echo ""
                    echo "========= Container Logs ========="
                    docker logs ${CONTAINER_NAME}

                    exit 1
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                sh """
                    EMAIL="arindam${env.BUILD_NUMBER}@gmail.com"

                    echo "Creating Employee..."

                    docker run --rm \
                        --network ${NETWORK_NAME} \
                        curlimages/curl:latest \
                        -s \
                        -X POST \
                        http://${CONTAINER_NAME}:${APP_PORT}/employees \
                        -H "Content-Type: application/json" \
                        -d '{
                            "firstName":"Arindam",
                            "lastName":"Tiwari",
                            "email":"'"\$EMAIL"'",
                            "department":"DevOps",
                            "salary":90000
                        }'

                    echo ""
                    echo "Verifying Employee..."

                    docker run --rm \
                        --network ${NETWORK_NAME} \
                        curlimages/curl:latest \
                        -s \
                        http://${CONTAINER_NAME}:${APP_PORT}/employees \
                        > employees.json

                    cat employees.json

                    grep "\$EMAIL" employees.json

                    echo ""
                    echo "Smoke Test Passed"
                """
            }
        }

        stage('Deployment Summary') {
            steps {
                script {
                    sh """
                        echo ""
                        echo "==============================================================="
                        echo "                 DEPLOYMENT SUMMARY"
                        echo "==============================================================="
                        echo " Application Name : ${APP_NAME}"
                        echo " Docker Image     : ${IMAGE_NAME}:${env.BUILD_NUMBER}"
                        echo " Container Name   : ${CONTAINER_NAME}"
                        echo ""
                        echo " System Information : http://localhost:${APP_PORT}/system/info"
                        echo " Application URL  : http://localhost:${APP_PORT}/employees"
                        echo " Health URL       : http://localhost:${APP_PORT}${HEALTH_ENDPOINT}"
                        echo " Info URL         : http://localhost:${APP_PORT}/actuator/info"
                        echo ""
                        echo "-------------- Spring Boot Actuator ----------------"
                        echo " Health Endpoint    : http://localhost:${APP_PORT}/actuator/health"
                        echo " Info Endpoint      : http://localhost:${APP_PORT}/actuator/info"
                        echo " Build Number     : ${env.BUILD_NUMBER}"
                        echo " Jenkins Job      : ${JOB_NAME}"
                        echo " Build URL        : ${BUILD_URL}"
                        echo ""
                        echo " Status           : DEPLOYMENT SUCCESSFUL"
                        echo "==============================================================="
                    """
                }
            }
        }

   /*     stage('Health Check') {
            steps {
                sh '''
                    echo "Waiting for application to start..."
                    sleep 20

                    echo "Running Health Check..."

                   # curl -f http://employee-service:8081/employees
                   # curl -f  http://localhost:8081/employees


                '''
            }
        }

        stage('Smoke Test') {
            steps {
                sh '''
                    echo "Running Smoke Test..."

                    curl -X POST http://localhost:8081/employees \
                    -H "Content-Type: application/json" \
                    -d '{
                        "firstName":"Arindam",
                        "lastName":"Tiwari",
                        "email":"arindam@example.com",
                        "department":"IT",
                        "salary":90000
                    }'

                    echo ""
                    echo "Verifying inserted employee..."

                    curl -f http://employee-service:8081/employees

                    echo ""
                    echo "Smoke Test Passed"
                '''
            }
        }  */

        stage('Verify Deployment') {
            steps {
                sh '''
                    sleep 20

                    docker ps

                    docker logs ${CONTAINER_NAME} --tail 50
                '''
            }
        }

        stage('Docker Cleanup') {
            steps {
                sh """
                    echo "Cleaning Docker..."

                    docker image prune -af --filter "until=24h"
                    # docker image prune -f
                    # docker builder prune -f

                    echo "Docker Cleanup Completed."
                """
            }
        }

   /*     stage('List Docker Images') {
            steps {
                sh 'docker images'
            }
        } */
    } 

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed.'
        }
    }
}