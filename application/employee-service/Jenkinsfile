        stage('Docker Push') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${env.BUILD_NUMBER}
                        # docker push ${IMAGE_NAME}:latest
                        docker logout
                    """
                }
            }
        }

        stage('Kubernetes Connectivity Test') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'docker-desktop-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        echo "=========================================="
                        echo "Kubernetes Connectivity Test"
                        echo "=========================================="

                        # Purpose: Verify kubectl is installed.
                        kubectl version --client

                        # Purpose: Verify Jenkins can authenticate to Kubernetes.
                        kubectl get nodes

                        # Purpose: Verify Jenkins can access the application namespace.
                        kubectl get namespace employee-devops

                        # Purpose: Verify current application state.
                        kubectl get deployment -n employee-devops
                        kubectl get pods -n employee-devops
                    '''
                }
            }
        }

        stage('Capture Kubernetes Deployment State') {

            steps {

                withCredentials([
                    file(
                        credentialsId: 'docker-desktop-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {

                    script {

                        echo "=========================================="
                        echo "KUBERNETES DEPLOYMENT DEBUG"
                        echo "=========================================="

                        /*
                        * First verify that the Deployment exists
                        * and show the actual container/image information.
                        */
                        sh """
                            echo "Deployment:"
                            kubectl get deployment ${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE} \
                                -o wide

                            echo ""
                            echo "Containers and Images:"

                            kubectl get deployment ${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE} \
                                -o json \
                                | jq -r '.spec.template.spec.containers[] | "Container=" + .name + " Image=" + .image'

                            echo ""
                            echo "=========================================="
                        """

                        /*
                        * Capture the image belonging specifically
                        * to the Kubernetes container we are deploying.
                        *
                        * jq is used here instead of JSONPath so that
                        * we explicitly select the container by name.
                        */
                        env.PREVIOUS_IMAGE = sh(
                            script: """
                                set -e

                                kubectl get deployment ${K8S_DEPLOYMENT} \
                                    -n ${K8S_NAMESPACE} \
                                    -o json \
                                | jq -r --arg CONTAINER "${K8S_CONTAINER}" \
                                    '.spec.template.spec.containers[]
                                    | select(.name == \$CONTAINER)
                                    | .image'
                            """,
                            returnStdout: true
                        ).trim()

                        echo "=========================================="
                        echo "CURRENT KUBERNETES DEPLOYMENT"
                        echo "=========================================="
                        echo "Deployment     : ${K8S_DEPLOYMENT}"
                        echo "Namespace      : ${K8S_NAMESPACE}"
                        echo "Container      : ${K8S_CONTAINER}"
                        echo "Previous Image : ${env.PREVIOUS_IMAGE}"
                        echo "New Image      : ${IMAGE_NAME}:${BUILD_NUMBER}"
                        echo "=========================================="

                        /*
                        * Never continue if Kubernetes did not return
                        * an actual image.
                        */
                        if (!env.PREVIOUS_IMAGE ||
                            env.PREVIOUS_IMAGE.trim() == "" ||
                            env.PREVIOUS_IMAGE.trim() == "null") {

                            error """
                            Previous Kubernetes image could not be determined.

                            Deployment : ${K8S_DEPLOYMENT}
                            Namespace  : ${K8S_NAMESPACE}
                            Container  : ${K8S_CONTAINER}
                            Captured   : '${env.PREVIOUS_IMAGE}'

                            Deployment will NOT continue.
                            """
                        }

                        echo "Previous Kubernetes image captured successfully:"
                        echo "${env.PREVIOUS_IMAGE}"
                    }
                }
            }
        }

