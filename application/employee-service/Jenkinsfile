        stage('Verify Deployment') {
            steps {
                sh '''
                    sleep 20

                    docker ps

                    docker logs ${CONTAINER_NAME} --tail 50
                '''
            }
        }

        stage('Docker Cleanup') {
            steps {
                sh """
                    echo "Cleaning Docker..."

                    docker image prune -af --filter "until=24h"
                    # docker image prune -f
                    # docker builder prune -f

                    echo "Docker Cleanup Completed."
                """
            }
        }

   /*     stage('List Docker Images') {
            steps {
                sh 'docker images'
            }
        } */
    } 

    post {

        success {

            echo '=========================================='
            echo 'Pipeline completed successfully.'
            echo '=========================================='
        }

        failure {

            echo '=========================================='
            echo 'Pipeline FAILED'
            echo '=========================================='

            script {

                if (env.DEPLOYMENT_STARTED == "true" &&
                    env.PREVIOUS_IMAGE?.trim()) {

                    echo "Deployment was started."
                    echo "Previous image: ${env.PREVIOUS_IMAGE}"
                    echo "Starting automatic rollback..."

                    sh """
                        echo "=========================================="
                        echo "ROLLBACK STARTED"
                        echo "=========================================="

                        echo "Restoring image:"
                        echo "${env.PREVIOUS_IMAGE}"

                        cd ${COMPOSE_DIR}

                        export IMAGE_TAG="${env.PREVIOUS_IMAGE*:}"

                        docker compose down || true

                        docker compose up -d

                        echo "Waiting for rollback application..."

                        sleep 15

                        docker ps

                        echo "Rollback container logs:"
                        docker logs ${CONTAINER_NAME} --tail 50 || true

                        echo "=========================================="
                        echo "ROLLBACK COMPLETED"
                        echo "Restored: ${env.PREVIOUS_IMAGE}"
                        echo "=========================================="
                    """

                } else {

                    echo "No deployment rollback required."
                    echo "Failure occurred before deployment."
                }
            }
        }
    }
}