                '''
            }
        }  */
            // --scanners vuln \   to disable secret scanning as scanning is slow 
            // -v trivy-cache:/root/.cache/trivy  --- to cache trivy scan results for faster subsequent scans 
  
   /*     stage('Trivy Security Scan') {

            steps {

                sh '''

                mkdir -p reports

