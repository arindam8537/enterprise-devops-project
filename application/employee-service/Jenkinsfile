        stage('Docker Push') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${env.BUILD_NUMBER}
                        # docker push ${IMAGE_NAME}:latest
                        docker logout
                    """
                }
            }
        }

        stage('Kubernetes Connectivity Test') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'docker-desktop-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        echo "=========================================="
                        echo "Kubernetes Connectivity Test"
                        echo "=========================================="

                        # Purpose: Verify kubectl is installed.
                        kubectl version --client

                        # Purpose: Verify Jenkins can authenticate to Kubernetes.
                        kubectl get nodes

                        # Purpose: Verify Jenkins can access the application namespace.
                        kubectl get namespace employee-devops

                        # Purpose: Verify current application state.
                        kubectl get deployment -n employee-devops
                        kubectl get pods -n employee-devops
                    '''
                }
            }
        }

        stage('Capture Kubernetes Deployment State') {

            steps {

                withCredentials([
                    file(
                        credentialsId: 'docker-desktop-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {

                    script {

                        echo "=========================================="
                        echo "CURRENT KUBERNETES DEPLOYMENT"
                        echo "=========================================="

                        /*
                        * Kubernetes is the source of truth.
                        * We only display the currently deployed image here.
                        *
                        * We do NOT store it in env.PREVIOUS_IMAGE.
                        */

                        sh """
                            echo "Deployment     : ${K8S_DEPLOYMENT}"
                            echo "Namespace      : ${K8S_NAMESPACE}"
                            echo "Container      : ${K8S_CONTAINER}"

                            echo ""
                            echo "Current Image:"
                            kubectl get deployment ${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE} \
                                -o jsonpath='{.spec.template.spec.containers[0].image}'

                            echo ""
                            echo "=========================================="
                        """
                    }
                }
            }
        }


// added new Deploy Container stage to skip tag latest instead will use build number tag for deployment to 
// avoid issues with latest tag caching in docker and also to maintain versioning of docker images for better 
// traceability and rollback if needed
