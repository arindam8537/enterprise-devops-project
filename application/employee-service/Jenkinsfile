                echo "IMAGE_NAME   = ${IMAGE_NAME}"
            }
        } */

        stage('Build Docker Image') {
            steps {
                dir('application/employee-service') {
                    sh """
                        docker build -t ${IMAGE_NAME}:${env.BUILD_NUMBER} .
                        docker tag ${IMAGE_NAME}:${env.BUILD_NUMBER} ${IMAGE_NAME}:latest
                    """
                }
            }
        }
