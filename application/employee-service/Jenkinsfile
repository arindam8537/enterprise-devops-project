        stage('Deploy to Kubernetes') {

            steps {

                withCredentials([
                    file(
                        credentialsId: 'docker-desktop-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {

                    script {

                        echo "=========================================="
                        echo "KUBERNETES DEPLOYMENT"
                        echo "=========================================="

                        echo "Namespace : ${K8S_NAMESPACE}"
                        echo "Deployment: ${K8S_DEPLOYMENT}"
                        echo "Container : ${K8S_CONTAINER}"
                        echo "Previous  : ${env.PREVIOUS_IMAGE}"
                        echo "New Image : ${IMAGE_NAME}:${BUILD_NUMBER}"

                        /*
                        * Update only the Kubernetes image.
                        *
                        * If kubectl set image fails, Jenkins stops here
                        * and DEPLOYMENT_STARTED remains false.
                        */
                        sh """
                            set -e

                            kubectl set image \
                                deployment/${K8S_DEPLOYMENT} \
                                ${K8S_CONTAINER}=${IMAGE_NAME}:${BUILD_NUMBER} \
                                -n ${K8S_NAMESPACE}

                            echo ""
                            echo "Deployment image updated successfully."

                            echo ""
                            echo "Current Deployment Image:"
                            kubectl get deployment ${K8S_DEPLOYMENT} \
                                -n ${K8S_NAMESPACE} \
                                -o jsonpath='{.spec.template.spec.containers[?(@.name=="${K8S_CONTAINER}")].image}'

                            echo ""
                        """

                        /*
                        * IMPORTANT:
                        * Set this ONLY after kubectl set image succeeded.
                        */
                        env.DEPLOYMENT_STARTED = "true"

                        echo "DEPLOYMENT_STARTED = ${env.DEPLOYMENT_STARTED}"
                    }
                }
            }
        }

        stage('Annotate Deployment') {

            steps {

                withCredentials([
                    file(
                        credentialsId: 'docker-desktop-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {

                    sh """
                        # Purpose:
                        # Record why this Kubernetes Deployment changed.
                        kubectl annotate deployment ${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE} \
                            kubernetes.io/change-cause="Jenkins Build #${BUILD_NUMBER} - ${IMAGE_NAME}:${BUILD_NUMBER} - Commit ${GIT_COMMIT_SHORT}" \
                            --overwrite

                        echo "Deployment change cause recorded."
                    """
                }
            }
        }

        stage('Kubernetes Rollout Status') {

            steps {

                withCredentials([
                    file(
                        credentialsId: 'docker-desktop-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {

                    sh """
                        echo "=========================================="
                        echo "WAITING FOR KUBERNETES ROLLOUT"
                        echo "=========================================="

                        kubectl rollout status \
                            deployment/${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE} \
                            --timeout=${K8S_ROLLOUT_TIMEOUT}

                        echo ""
                        echo "Rollout completed successfully."
                    """
                }
            }
        }

        stage('Verify Kubernetes Resources') {

            steps {

                withCredentials([
                    file(
                        credentialsId: 'docker-desktop-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {

                    sh """
                        echo "=========================================="
                        echo "KUBERNETES RESOURCE VERIFICATION"
                        echo "=========================================="

                        echo ""
                        echo "Deployment:"
                        kubectl get deployment ${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE}

                        echo ""
                        echo "Pods:"
                        kubectl get pods \
                            -n ${K8S_NAMESPACE} \
                            -l app=${APP_NAME} \
                            -o wide

                        echo ""
                        echo "Service:"
                        kubectl get service ${K8S_SERVICE} \
                            -n ${K8S_NAMESPACE}

                        echo ""
                        echo "EndpointSlices:"
                        kubectl get endpointslices \
                            -n ${K8S_NAMESPACE} \
                            -l kubernetes.io/service-name=${K8S_SERVICE}

                        echo ""
                        echo "Deployment image:"
                        kubectl get deployment ${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE} \
                            -o jsonpath='{.spec.template.spec.containers[0].image}'

                        echo ""
                    """
                }
            }
        }
/* -- commented as adding new health check stage for k8s deployment
        stage('Health Check') {
            steps {
                sh '''
                    echo "========================================"
                    echo "Starting Health Check..."
                    echo "========================================"

                    MAX_RETRIES=12
                    RETRY_INTERVAL=5
                    COUNT=1

                    while [ $COUNT -le $MAX_RETRIES ]
                    do
                        echo ""
                        echo "Attempt $COUNT of $MAX_RETRIES"

                        if docker exec ${CONTAINER_NAME} \
                            wget -q --spider http://localhost:${APP_PORT}${HEALTH_ENDPOINT}
                        then
                            echo ""
                            echo "Application is Healthy"
                            docker exec ${CONTAINER_NAME} \
                                wget -qO- http://localhost:${APP_PORT}${HEALTH_ENDPOINT}
                            exit 0
                        fi

                        echo "Application not ready..."
                        sleep $RETRY_INTERVAL

                        COUNT=$((COUNT+1))
                    done

                    echo ""
                    echo "Health Check Failed"

                    echo ""
                    echo "========= Container Logs ========="
                    docker logs ${CONTAINER_NAME}

                    exit 1
                '''
            }
        } -- commented as adding new health check stage for k8s deployment */

        stage('Application Health Check') {

            steps {

                withCredentials([
                    file(
                        credentialsId: 'docker-desktop-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {

                    sh """
                        set -e

                        echo "=========================================="
                        echo "APPLICATION HEALTH CHECK"
                        echo "=========================================="

                        # Purpose:
                        # Create a temporary connection from Jenkins
                        # to the Kubernetes Service.
                        kubectl port-forward \
                            service/${K8S_SERVICE} \
                            ${K8S_HEALTH_PORT}:${APP_PORT} \
                            -n ${K8S_NAMESPACE} \
                            >/tmp/employee-service-port-forward.log 2>&1 &

                        PF_PID=\$!

                        echo "Port-forward PID: \$PF_PID"

                        # Purpose:
                        # Give kubectl port-forward a moment to establish.
                        sleep 5

                        echo ""
                        echo "Port-forward log:"
                        cat /tmp/employee-service-port-forward.log || true

                        MAX_RETRIES=12
                        RETRY_INTERVAL=5
                        COUNT=1

                        while [ \$COUNT -le \$MAX_RETRIES ]
                        do

                            echo ""
                            echo "Health check attempt \$COUNT of \$MAX_RETRIES"

                            if curl -fsS \
                                http://127.0.0.1:${K8S_HEALTH_PORT}${HEALTH_ENDPOINT}
                            then

                                echo ""
                                echo "=========================================="
                                echo "APPLICATION HEALTH CHECK PASSED"
                                echo "=========================================="

                                kill \$PF_PID || true

                                exit 0
                            fi

                            echo "Application is not ready yet."

                            sleep \$RETRY_INTERVAL

                            COUNT=\$((COUNT+1))

                        done

                        echo ""
                        echo "=========================================="
                        echo "APPLICATION HEALTH CHECK FAILED"
                        echo "=========================================="

                        echo ""
                        echo "Port-forward log:"
                        cat /tmp/employee-service-port-forward.log || true

                        kill \$PF_PID || true

                        exit 1
                    """
                }
            }
        }
