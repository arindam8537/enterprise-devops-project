pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
    }

    environment {
        // Application
        APP_NAME        = "employee-service"
        APP_PORT        = "8081"

        // Docker
        DOCKER_USERNAME = "arindamtiwari"
        IMAGE_NAME      = "${DOCKER_USERNAME}/${APP_NAME}"
        CONTAINER_NAME  = "employee-service"

        // Docker Compose
        COMPOSE_DIR     = "deployment"
        NETWORK_NAME    = "deployment_employee-network"

        // Separate Kubernetes deployment repository and CD job
        DEPLOYMENT_REPO_URL = "https://github.com/arindam8537/employee-k8s.git"
        DEPLOYMENT_REPO_DIR = "employee-k8s-work"
        DEPLOYMENT_BRANCH   = "main"
        DEPLOYMENT_CREDENTIALS = "github_terraform"  // GitHub credentials for pushing to the deployment repository
        CD_JOB_NAME         = "employee-k8s-cd"

        // SonarQube
        SONARQUBE_SERVER = "SonarQube"
        SONAR_PROJECT_KEY = "employee-service"
        SONAR_PLUGIN_VERSION = "5.7.0.6970"

        // Health Check
        HEALTH_ENDPOINT = "/actuator/health"

        // NVD API Key for OWASP Dependency Check
        NVD_API_KEY = credentials('nvd-api-key')

     //   DEPLOYMENT_STARTED = "false"
     //   PREVIOUS_IMAGE = ""
        IMAGE_TAG  = "${BUILD_NUMBER}"
        // Docker cleanup is disabled for now; set to "true" when ready to purge old Jenkins/DinD images.
        DOCKER_CLEANUP_ENABLED = "false"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Build Metadata') {
            steps {
                script {

                    env.APP_VERSION = sh(
                        script: '''
                            cd application/employee-service
                            mvn help:evaluate \
                                -Dexpression=project.version \
                                -q \
                                -DforceStdout
                        ''',
                        returnStdout: true
                    ).trim()

                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.BUILD_TIME = sh(
                        script: 'date -u +"%Y-%m-%dT%H:%M:%SZ"',
                        returnStdout: true
                    ).trim()

                    echo "==============================================="
                    echo "BUILD METADATA"
                    echo "==============================================="
                    echo "Application : ${APP_NAME}"
                    echo "Version     : ${APP_VERSION}"
                    echo "Build       : ${BUILD_NUMBER}"
                    echo "Git Commit  : ${GIT_COMMIT_SHORT}"
                    echo "Build Time  : ${BUILD_TIME}"
                    echo "Docker Image: ${IMAGE_NAME}:${BUILD_NUMBER}"
                    echo "==============================================="
                }
            }
        }

        stage('Generate Build Info') {
            steps {
                script {

                    sh """
                        mkdir -p application/employee-service/src/main/resources

                        cat > application/employee-service/src/main/resources/info.json <<EOF
        {
        "app": {
            "name": "${APP_NAME}",
            "description": "Spring Boot Employee Management API",
            "version": "${APP_VERSION}",
            "buildNumber": "${BUILD_NUMBER}",
            "dockerImage": "${IMAGE_NAME}:${BUILD_NUMBER}",
            "gitCommit": "${GIT_COMMIT_SHORT}",
            "environment": "Development",
            "buildTime": "${BUILD_TIME}",
            "jenkinsJob": "${JOB_NAME}",
            "jenkinsBuildUrl": "${BUILD_URL}"
        }
        }
        EOF
                    """

                    echo "Build information generated successfully."
                }
            }
        }

        stage('Build') {
            steps {
                dir('application/employee-service') {
                    sh 'mvn clean package'
                }
            }
        }
/* --- commented as stuck here frequently "Injecting SonarQube environment variables using the configuration: SonarQube"
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONARQUBE_SERVER}") {
                    dir('application/employee-service') {
                        sh """
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:${SONAR_PLUGIN_VERSION}:sonar \
                            -Dsonar.projectKey=${SONAR_PROJECT_KEY}
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {

            steps {

                timeout(time: 5, unit: 'MINUTES') {

                    waitForQualityGate abortPipeline: true

                }

            }

        } -- commented as stuck here frequently "Injecting SonarQube environment variables using the configuration: SonarQube" */

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'application/employee-service/target/*.jar', fingerprint: true
            }
        }

 /*      stage('Debug') {
            steps {
                echo "BUILD_NUMBER = ${env.BUILD_NUMBER}"
                echo "IMAGE_NAME   = ${IMAGE_NAME}"
            }
        } */

        stage('Build Docker Image') {
            steps {
                dir('application/employee-service') {
                    sh """
                        docker build -t ${IMAGE_NAME}:${env.BUILD_NUMBER} .
                        docker tag ${IMAGE_NAME}:${env.BUILD_NUMBER} ${IMAGE_NAME}:latest
                    """
                }
            }
        }
        // DevSecOps (Trivy Image Scan) // commented out for now, as we want reports in text, json and html formats for better analysis and reporting
   /*     stage('Trivy Image Scan') {

