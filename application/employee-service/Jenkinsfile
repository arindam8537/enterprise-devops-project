pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
    }

    environment {
        // Application
        APP_NAME        = "employee-service"
        APP_PORT        = "8081"

        // Docker
        DOCKER_USERNAME = "arindamtiwari"
        IMAGE_NAME      = "${DOCKER_USERNAME}/${APP_NAME}"
        CONTAINER_NAME  = "employee-service"

        // Docker Compose
        COMPOSE_DIR     = "deployment"
        NETWORK_NAME    = "deployment_employee-network"

        // Kubernetes
        K8S_NAMESPACE       = "employee-devops"
        K8S_DEPLOYMENT      = "employee-service"
        K8S_CONTAINER       = "employee-service"
        K8S_SERVICE         = "employee-service"
        K8S_HEALTH_PORT     = "18081"
        K8S_ROLLOUT_TIMEOUT = "300s"

        // SonarQube
        SONARQUBE_SERVER = "SonarQube"
        SONAR_PROJECT_KEY = "employee-service"
        SONAR_PLUGIN_VERSION = "5.7.0.6970"

        // Health Check
        HEALTH_ENDPOINT = "/actuator/health"

        // NVD API Key for OWASP Dependency Check
        NVD_API_KEY = credentials('nvd-api-key')

        DEPLOYMENT_STARTED = "false"
        PREVIOUS_IMAGE = ""
        IMAGE_TAG  = "${BUILD_NUMBER}"
    }



