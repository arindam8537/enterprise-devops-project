        }

        stage('Archive Security Reports') {

            steps {

                archiveArtifacts artifacts: 'reports/**', fingerprint: true

            }
        }   --- commeted as report generated and testing is done 
         /*    stage('OWASP Dependency Check') { -- commented from this */

        stage('Docker Push') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${env.BUILD_NUMBER}
                        # docker push ${IMAGE_NAME}:latest
                        docker logout
                    """
                }
            }
        }


        stage('Update Deployment Repository Image') {
            steps {
                dir("${DEPLOYMENT_REPO_DIR}") {
                    deleteDir()
                    git branch: "${DEPLOYMENT_BRANCH}",
                        credentialsId: "${DEPLOYMENT_CREDENTIALS}",
                        url: "${DEPLOYMENT_REPO_URL}"
/* -- commented as sed command not working ---
                    sh '''
                        set -eu
                        echo "Deployment manifest before update:"
                        grep -nE '^[[:space:]]*image:' deployment.yaml

                        image_line_count=$(grep -Ec '^[[:space:]]*image:[[:space:]]*arindamtiwari/employee-service:' deployment.yaml || true)
                        if [ "$image_line_count" -ne 1 ]; then
                            echo "ERROR: Expected exactly one employee-service image line in deployment.yaml; found $image_line_count"
                            exit 1
                        fi

                      #  sed -i -E "s|(^[[:space:]]*image:[[:space:]]*)arindamtiwari/employee-service:[^[:space:]]+|\1${IMAGE_NAME}:${BUILD_NUMBER}|" deployment.yaml
                        sed -i -E "/^[[:space:]]*image:[[:space:]]*arindamtiwari\/employee-service:/s|image:.*|image: ${IMAGE_NAME}:${BUILD_NUMBER}|" deployment.yaml

                        updated_image_count=$(grep -Ec "^[[:space:]]*image:[[:space:]]*${IMAGE_NAME}:${BUILD_NUMBER}$" deployment.yaml || true)
                        if [ "$updated_image_count" -ne 1 ]; then
                            echo "ERROR: deployment.yaml image tag was not updated exactly as expected."
                            grep -nE '^[[:space:]]*image:' deployment.yaml || true
                            exit 1
                        fi

                        git diff --check
                        git diff -- deployment.yaml
                    '''  -- commented till here and using awk  */
                    sh '''
                        set -eu

                        echo "Deployment manifest before update:"
                        grep -nE '^[[:space:]]*image:' deployment.yaml

                        image_line_count=$(grep -Ec '^[[:space:]]*image:[[:space:]]*arindamtiwari/employee-service:' deployment.yaml || true)

                        if [ "$image_line_count" -ne 1 ]; then
                            echo "ERROR: Expected exactly one employee-service image line; found $image_line_count"
                            exit 1
                        fi

                        # Replace the complete image reference using awk.
                        awk -v tag="$BUILD_NUMBER" '
                            /^[[:space:]]*image:[[:space:]]*arindamtiwari\\/employee-service:/ {
                                sub(/arindamtiwari\\/employee-service:[^[:space:]]+/, "arindamtiwari/employee-service:" tag)
                            }
                            { print }
                        ' deployment.yaml > deployment.yaml.tmp

                        mv deployment.yaml.tmp deployment.yaml

                        echo "Deployment manifest after update:"
                        grep -nE '^[[:space:]]*image:' deployment.yaml

                        updated_image_count=$(grep -Ec '^[[:space:]]*image:[[:space:]]*arindamtiwari/employee-service:'"$BUILD_NUMBER"'[[:space:]]*$' deployment.yaml || true)

                        if [ "$updated_image_count" -ne 1 ]; then
                            echo "ERROR: Image tag update failed."
                            exit 1
                        fi

                        git diff --check
                        git diff -- deployment.yaml
                    '''

                    withCredentials([usernamePassword(
                        credentialsId: "${DEPLOYMENT_CREDENTIALS}",
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )]) {
                        sh '''
                            set -eu
                            git config user.name "Jenkins CI"
                            git config user.email "jenkins-ci@localhost"

                            if git diff --quiet -- deployment.yaml; then
                                echo "Manifest already points to ${IMAGE_NAME}:${BUILD_NUMBER}; no commit is needed."
                            else
                                git add deployment.yaml
                                git commit -m "Deploy employee-service image ${BUILD_NUMBER}"

                                cat > .git/askpass.sh <<'ASKPASS'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\n' "$GH_USER" ;;
  *Password*) printf '%s\n' "$GH_TOKEN" ;;
  *) printf '\n' ;;
esac
ASKPASS
                                chmod 700 .git/askpass.sh
                                trap 'rm -f .git/askpass.sh' EXIT
                                GIT_ASKPASS="$PWD/.git/askpass.sh" GIT_TERMINAL_PROMPT=0 git push origin "HEAD:${DEPLOYMENT_BRANCH}"
                            fi

                            echo "Deployment repository now references:"
                            grep -nE '^[[:space:]]*image:' deployment.yaml
                        '''
                    }
                }
            }
        }

        stage('Trigger Kubernetes CD') {
            steps {
                script {
                    echo "Triggering ${CD_JOB_NAME} to validate and deploy the manifest from ${DEPLOYMENT_BRANCH}."
                    build job: "${CD_JOB_NAME}", wait: true, propagate: true
                }
            }
        }
    }

    post {
        success {
            echo "Application CI succeeded, image ${IMAGE_NAME}:${BUILD_NUMBER} was published, and Kubernetes CD completed successfully."
        }
        failure {
            echo "Application CI or the downstream Kubernetes CD job failed. Check this build's stage logs and the employee-k8s-cd build log."
        }
        cleanup {
            script {
                if (env.DOCKER_CLEANUP_ENABLED == 'true') {
                    sh 'docker image prune -f || true'
                } else {
                    echo 'Docker cleanup is disabled; no images were pruned.'
                }
            }
        }
    }
}
