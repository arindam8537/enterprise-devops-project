pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
    }

    environment {
        APP_NAME   = "employee-service"
        IMAGE_NAME = "arindamtiwari/employee-service"
       // IMAGE_TAG  = "${BUILD_NUMBER}"
        APP_PORT   = "8081"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('application/employee-service') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'application/employee-service/target/*.jar', fingerprint: true
            }
        }

 /*      stage('Debug') {
            steps {
                echo "BUILD_NUMBER = ${env.BUILD_NUMBER}"
                echo "IMAGE_NAME   = ${IMAGE_NAME}"
            }
        } */

        stage('Build Docker Image') {
            steps {
                dir('application/employee-service') {
                    sh """
                        docker build -t ${IMAGE_NAME}:${env.BUILD_NUMBER} .
                        docker tag ${IMAGE_NAME}:${env.BUILD_NUMBER} ${IMAGE_NAME}:latest
                    """
                }
            }
        }

        stage('Docker Push') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${env.BUILD_NUMBER}
                        docker push ${IMAGE_NAME}:latest
                        docker logout
                    """
                }
            }
        }

  /*      stage('Deploy Container') {
            steps {
                sh """
                    docker stop employee-service || true
                    docker rm -f employee-service || true

                    docker run -d \
                    --name employee-service \
                    --restart unless-stopped \
                    --network employee-service_default \
                    -p 8081:8081 \
                    -e SPRING_DATASOURCE_URL=jdbc:mysql://employee-mysql:3306/employee_db \
                    -e SPRING_DATASOURCE_USERNAME=root \
                    -e SPRING_DATASOURCE_PASSWORD=root \
                    ${IMAGE_NAME}:${env.BUILD_NUMBER}
                """
            }
        }  */

        stage('Deploy') {

            steps {

                dir('deployment') {

                    withEnv([
                        "IMAGE_NAME=${IMAGE_NAME}:latest"
                    ]) {

                        sh '''
                            docker compose down || true
                            docker compose pull
                            docker compose up -d
                        '''
                    }
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    sleep 20

                    docker ps

                    docker logs employee-service --tail 50
                '''
            }
        }


        stage('List Docker Images') {
            steps {
                sh 'docker images'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed.'
        }
    }
}